rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default to deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Setoran collection
    match /setoran/{id} {
      allow read, write: if request.auth != null;
    }

    // Mustahik collection
    match /mustahik/{id} {
      allow read, write: if request.auth != null;
    }

    // Penyaluran collection
    match /penyaluran/{id} {
      allow read, write: if request.auth != null;
    }

    // Security config document
    match /config/security {
      allow read, write: if request.auth != null;
    }
  }
}
